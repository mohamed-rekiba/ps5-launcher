{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Emulator",
  "description": "One emulator addon: the whole of emulators/<id>/emulator.yaml.",
  "type": "object",
  "properties": {
    "catalogs": {
      "description": "Offline release catalogs contributed to the shared Library. Launching does not\nrequire a catalog; existing and user-added addons may omit this section.",
      "type": "array",
      "items": {
        "$ref": "#/$defs/Catalog"
      }
    },
    "compatibility": {
      "$ref": "#/$defs/CompatibilityParser"
    },
    "consoles": {
      "description": "The consoles whose games it runs.",
      "type": "array",
      "items": {
        "$ref": "#/$defs/Console"
      }
    },
    "content": {
      "$ref": "#/$defs/Content"
    },
    "controls": {
      "description": "A file in the addon's folder with the keyboard and controller reference.",
      "anyOf": [
        {
          "$ref": "#/$defs/RelPath"
        },
        {
          "type": "null"
        }
      ]
    },
    "custom_build": {
      "$ref": "#/$defs/CustomBuild"
    },
    "display_name": {
      "description": "The name the launcher shows.",
      "type": "string"
    },
    "enabled": {
      "description": "A disabled emulator keeps its settings but runs no games.",
      "type": "boolean"
    },
    "icon": {
      "description": "An image file in the addon's folder.",
      "anyOf": [
        {
          "$ref": "#/$defs/RelPath"
        },
        {
          "type": "null"
        }
      ]
    },
    "id": {
      "description": "The same as the addon's folder name.",
      "$ref": "#/$defs/EmulatorId"
    },
    "install": {
      "description": "How a managed build is installed. Required with a `github_latest` release.",
      "anyOf": [
        {
          "$ref": "#/$defs/Installer"
        },
        {
          "type": "null"
        }
      ]
    },
    "launch": {
      "$ref": "#/$defs/Launch"
    },
    "macos": {
      "anyOf": [
        {
          "$ref": "#/$defs/Macos"
        },
        {
          "type": "null"
        }
      ]
    },
    "min_launcher_version": {
      "description": "The oldest launcher that can use this addon. An older one leaves it untouched and\nunavailable.",
      "anyOf": [
        {
          "$ref": "#/$defs/LauncherVersion"
        },
        {
          "type": "null"
        }
      ]
    },
    "release": {
      "$ref": "#/$defs/ReleaseSource"
    },
    "schema_version": {
      "description": "The format's version; it selects the meaning of the rest. This launcher reads version 1.",
      "type": "integer",
      "format": "uint32",
      "minimum": 0
    },
    "session": {
      "$ref": "#/$defs/Session"
    },
    "settings": {
      "$ref": "#/$defs/Settings"
    },
    "update": {
      "description": "Automatic updates. Required with a `github_latest` release.",
      "anyOf": [
        {
          "$ref": "#/$defs/Update"
        },
        {
          "type": "null"
        }
      ]
    }
  },
  "additionalProperties": false,
  "required": [
    "schema_version",
    "id",
    "display_name",
    "consoles",
    "enabled",
    "release",
    "custom_build",
    "launch",
    "settings",
    "compatibility",
    "content",
    "session"
  ],
  "$defs": {
    "ArchiveMerge": {
      "oneOf": [
        {
          "description": "A folder the archive ships is copied into the shared one without overwriting.",
          "type": "string",
          "const": "copy_missing"
        }
      ]
    },
    "ArgType": {
      "description": "How a value becomes an argument.",
      "oneOf": [
        {
          "type": "string",
          "enum": [
            "path",
            "u32",
            "string",
            "enum"
          ]
        },
        {
          "description": "A switch as \"true\" or \"false\".",
          "type": "string",
          "const": "bool_string"
        }
      ]
    },
    "ArgvEditor": {
      "oneOf": [
        {
          "description": "One line of text, split like a shell does with quotes (no shell runs).",
          "type": "string",
          "const": "legacy_quoted_arguments"
        }
      ]
    },
    "AssetSelection": {
      "oneOf": [
        {
          "description": "The first asset, in the release's order, that a target for this host matches.",
          "type": "string",
          "const": "first_match"
        }
      ]
    },
    "AssetTarget": {
      "description": "Which release assets suit one host. A name matches when it contains every `name_all`\nword, at least one `name_any` word (when there are any), starts with `name_prefix` (when\nset) and ends with one of `name_suffixes`.",
      "type": "object",
      "properties": {
        "case_sensitive": {
          "type": "boolean"
        },
        "host_arch": {
          "$ref": "#/$defs/HostArch"
        },
        "name_all": {
          "type": "array",
          "default": [],
          "items": {
            "type": "string"
          }
        },
        "name_any": {
          "type": "array",
          "default": [],
          "items": {
            "type": "string"
          }
        },
        "name_prefix": {
          "type": [
            "string",
            "null"
          ]
        },
        "name_suffixes": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "os": {
          "$ref": "#/$defs/Os"
        },
        "support": {
          "$ref": "#/$defs/TargetSupport"
        }
      },
      "additionalProperties": false,
      "required": [
        "os",
        "host_arch",
        "name_suffixes",
        "case_sensitive"
      ]
    },
    "Catalog": {
      "description": "Configuration for the compiled offline RuTracker snapshot importer. Paths are relative\nto the launcher's rutracker data folder and cache folder, respectively.",
      "type": "object",
      "properties": {
        "bundled_snapshot": {
          "description": "Fallback snapshot file inside this addon's folder. Default bundles copy their\nsnapshot there; user-added addons can supply any compatible snapshot.",
          "anyOf": [
            {
              "$ref": "#/$defs/RelPath"
            },
            {
              "type": "null"
            }
          ]
        },
        "cache": {
          "$ref": "#/$defs/RelPath"
        },
        "console": {
          "$ref": "#/$defs/Console"
        },
        "optional": {
          "description": "A missing, uncollected snapshot may contribute no games.",
          "type": "boolean"
        },
        "override_env": {
          "description": "Legacy environment override, containing a snapshot file path.",
          "type": [
            "string",
            "null"
          ]
        },
        "refresh_seconds": {
          "type": "integer",
          "format": "uint64",
          "minimum": 0
        },
        "snapshot": {
          "$ref": "#/$defs/RelPath"
        },
        "source": {
          "$ref": "#/$defs/HttpsUrl"
        }
      },
      "additionalProperties": false,
      "required": [
        "console",
        "source",
        "snapshot",
        "cache",
        "refresh_seconds",
        "optional"
      ]
    },
    "Choice": {
      "description": "A value and the name Settings shows for it.",
      "type": "object",
      "properties": {
        "label": {
          "type": "string"
        },
        "value": {
          "type": "string"
        }
      },
      "additionalProperties": false,
      "required": [
        "value",
        "label"
      ]
    },
    "CompatibilityParser": {
      "description": "Where the community's compatibility list comes from, and how it is read.",
      "oneOf": [
        {
          "description": "kytyps5.github.io's list: { \"PPSA…\": { \"status\", \"platforms\": { \"linux\": … } } }.",
          "type": "object",
          "properties": {
            "allowed_hosts": {
              "description": "The hosts `url`, `list_page` and the report form may use.",
              "type": "array",
              "items": {
                "$ref": "#/$defs/Host"
              }
            },
            "cache": {
              "description": "The cached copy's file name in the launcher's cache folder.",
              "$ref": "#/$defs/RelPath"
            },
            "list_page": {
              "description": "The page the launcher opens to show the whole list.",
              "$ref": "#/$defs/HttpsUrl"
            },
            "parser": {
              "type": "string",
              "const": "kyty_json_v1"
            },
            "refresh_seconds": {
              "type": "integer",
              "format": "uint32",
              "minimum": 0
            },
            "report": {
              "$ref": "#/$defs/ReportStrategy"
            },
            "selection": {
              "$ref": "#/$defs/CompatibilitySelection"
            },
            "url": {
              "$ref": "#/$defs/HttpsUrl"
            }
          },
          "additionalProperties": false,
          "required": [
            "parser",
            "url",
            "list_page",
            "cache",
            "refresh_seconds",
            "selection",
            "report",
            "allowed_hosts"
          ]
        },
        {
          "description": "shadPS4's list: { \"CUSA…\": { \"os-linux\": { \"status\": \"status-ingame\" } } }.",
          "type": "object",
          "properties": {
            "allowed_hosts": {
              "description": "The hosts `url`, `list_page` and the report form may use.",
              "type": "array",
              "items": {
                "$ref": "#/$defs/Host"
              }
            },
            "cache": {
              "description": "The cached copy's file name in the launcher's cache folder.",
              "$ref": "#/$defs/RelPath"
            },
            "list_page": {
              "description": "The page the launcher opens to show the whole list.",
              "$ref": "#/$defs/HttpsUrl"
            },
            "parser": {
              "type": "string",
              "const": "shad_json_v1"
            },
            "refresh_seconds": {
              "type": "integer",
              "format": "uint32",
              "minimum": 0
            },
            "report": {
              "$ref": "#/$defs/ReportStrategy"
            },
            "selection": {
              "$ref": "#/$defs/CompatibilitySelection"
            },
            "url": {
              "$ref": "#/$defs/HttpsUrl"
            }
          },
          "additionalProperties": false,
          "required": [
            "parser",
            "url",
            "list_page",
            "cache",
            "refresh_seconds",
            "selection",
            "report",
            "allowed_hosts"
          ]
        },
        {
          "description": "No list.",
          "type": "object",
          "properties": {
            "parser": {
              "type": "string",
              "const": "none"
            }
          },
          "additionalProperties": false,
          "required": [
            "parser"
          ]
        }
      ]
    },
    "CompatibilitySelection": {
      "oneOf": [
        {
          "description": "The Linux result when there is one (on macOS too), else the best result elsewhere.",
          "type": "string",
          "const": "legacy_linux_else_best"
        }
      ]
    },
    "CompositeRow": {
      "description": "A row that edits more than one setting.",
      "oneOf": [
        {
          "description": "Width and height, chosen from a list.",
          "type": "object",
          "properties": {
            "choices": {
              "type": "array",
              "items": {
                "type": "array",
                "maxItems": 2,
                "minItems": 2,
                "prefixItems": [
                  {
                    "type": "integer",
                    "format": "uint32",
                    "minimum": 0
                  },
                  {
                    "type": "integer",
                    "format": "uint32",
                    "minimum": 0
                  }
                ]
              }
            },
            "height": {
              "$ref": "#/$defs/SettingKey"
            },
            "hint": {
              "type": [
                "string",
                "null"
              ]
            },
            "id": {
              "$ref": "#/$defs/SettingKey"
            },
            "kind": {
              "type": "string",
              "const": "resolution_pair"
            },
            "label": {
              "type": "string"
            },
            "width": {
              "$ref": "#/$defs/SettingKey"
            }
          },
          "additionalProperties": false,
          "required": [
            "kind",
            "id",
            "width",
            "height",
            "label",
            "choices"
          ]
        }
      ]
    },
    "Console": {
      "type": "string",
      "enum": [
        "ps5",
        "ps4"
      ]
    },
    "Content": {
      "description": "How games for this emulator are recognized and where their updates and add-ons go.",
      "type": "object",
      "properties": {
        "layout": {
          "$ref": "#/$defs/ContentLayout"
        },
        "metadata": {
          "$ref": "#/$defs/Metadata"
        }
      },
      "additionalProperties": false,
      "required": [
        "metadata",
        "layout"
      ]
    },
    "ContentLayout": {
      "oneOf": [
        {
          "description": "The game's folder only.",
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "plain_folder"
            }
          },
          "additionalProperties": false,
          "required": [
            "kind"
          ]
        },
        {
          "description": "A game update beside the game as \"<folder><patch_suffix>\"; add-ons under `addons_root`.",
          "type": "object",
          "properties": {
            "addons_root": {
              "$ref": "#/$defs/DataRoot"
            },
            "kind": {
              "type": "string",
              "const": "shad_ps4"
            },
            "patch_suffix": {
              "type": "string"
            }
          },
          "additionalProperties": false,
          "required": [
            "kind",
            "patch_suffix",
            "addons_root"
          ]
        }
      ]
    },
    "ControlsProfile": {
      "type": "string",
      "enum": [
        "kyty_keyboard_v1",
        "shad_keyboard_v1",
        "none"
      ]
    },
    "CustomBuild": {
      "description": "The user's own build of the emulator.",
      "type": "object",
      "properties": {
        "allowed": {
          "type": "boolean"
        },
        "discovery": {
          "$ref": "#/$defs/Discovery"
        },
        "empty_path": {
          "description": "What an empty executable path means.",
          "$ref": "#/$defs/EmptyPath"
        },
        "version": {
          "$ref": "#/$defs/VersionStrategy"
        }
      },
      "additionalProperties": false,
      "required": [
        "allowed",
        "empty_path",
        "discovery",
        "version"
      ]
    },
    "CustomImport": {
      "oneOf": [
        {
          "description": "On the switch from a custom build: its data is copied into shared folders still empty.",
          "type": "string",
          "const": "copy_into_empty"
        }
      ]
    },
    "DataBase": {
      "oneOf": [
        {
          "description": "The launcher's data folder: $XDG_DATA_HOME/ps5-launcher, or ~/.local/share/ps5-launcher.",
          "type": "string",
          "const": "launcher_data"
        },
        {
          "description": "$XDG_DATA_HOME, or ~/.local/share.",
          "type": "string",
          "const": "xdg_data"
        }
      ]
    },
    "DataRoot": {
      "description": "A folder under one of the user's data folders.",
      "type": "object",
      "properties": {
        "base": {
          "$ref": "#/$defs/DataBase"
        },
        "relative": {
          "$ref": "#/$defs/RelPath"
        }
      },
      "additionalProperties": false,
      "required": [
        "base",
        "relative"
      ]
    },
    "Defer": {
      "oneOf": [
        {
          "description": "An update found during a game installs when the game ends.",
          "type": "string",
          "const": "any_live_game"
        },
        {
          "description": "The same, except the install that starts a game the player chose.",
          "type": "string",
          "const": "any_live_game_except_install_then_launch"
        }
      ]
    },
    "Discovery": {
      "oneOf": [
        {
          "type": "string",
          "enum": [
            "none"
          ]
        },
        {
          "description": "PATH, then KytyPS5's usual build folders.",
          "type": "string",
          "const": "legacy_kyty_locations_v1"
        }
      ]
    },
    "DisplayVersion": {
      "oneOf": [
        {
          "description": "\"KytyPS5-2026-09-29-59a1760\" shows as \"2026-09-29 · 59a1760\".",
          "type": "string",
          "const": "kyty_date_commit"
        },
        {
          "description": "\"v.0.18.0\" shows as \"0.18.0\".",
          "type": "string",
          "const": "strip_v_then_dot"
        }
      ]
    },
    "EmptyPath": {
      "oneOf": [
        {
          "description": "The managed build when it is installed, else a build found on this computer.",
          "type": "string",
          "const": "legacy_kyty_detection"
        },
        {
          "description": "The managed build.",
          "type": "string",
          "const": "managed"
        },
        {
          "description": "No emulator: the game does not start.",
          "type": "string",
          "const": "error"
        }
      ]
    },
    "EmulatorId": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9_-]{0,31}$"
    },
    "EnvName": {
      "type": "string",
      "pattern": "^[A-Za-z_][A-Za-z0-9_]{0,127}$"
    },
    "ErrorParser": {
      "oneOf": [
        {
          "type": "string",
          "enum": [
            "none"
          ]
        },
        {
          "description": "The text under \"--- Error ---\" in the log.",
          "type": "string",
          "const": "kyty_error_block"
        }
      ]
    },
    "FormatDetection": {
      "oneOf": [
        {
          "description": "A zip by its first bytes, else a tar archive.",
          "type": "string",
          "const": "zip_magic_else_tar"
        }
      ]
    },
    "GithubRepo": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+$"
    },
    "Host": {
      "type": "string",
      "pattern": "^[a-z0-9]([a-z0-9-]{0,61}[a-z0-9])?(\\.[a-z0-9]([a-z0-9-]{0,61}[a-z0-9])?)+$"
    },
    "HostArch": {
      "description": "The host architectures a target is for.",
      "oneOf": [
        {
          "type": "string",
          "enum": [
            "x86_64",
            "aarch64"
          ]
        },
        {
          "description": "Any architecture: the selector ignores it, as today's code does. It does not claim the\nasset runs everywhere.",
          "type": "string",
          "const": "legacy_any"
        }
      ]
    },
    "HttpsUrl": {
      "type": "string",
      "pattern": "^https://[^\\s@]+$"
    },
    "Installer": {
      "description": "How a managed build is unpacked and laid out.",
      "oneOf": [
        {
          "description": "An archive (zip or tar) whose executable is at its root or in one top-level folder.",
          "type": "object",
          "properties": {
            "current": {
              "description": "The link to the active version.",
              "$ref": "#/$defs/RelPath"
            },
            "executable": {
              "description": "The executable, inside a version folder.",
              "$ref": "#/$defs/PerOs"
            },
            "format_detection": {
              "$ref": "#/$defs/FormatDetection"
            },
            "kind": {
              "type": "string",
              "const": "archive_flat_or_one_child"
            },
            "probe": {
              "$ref": "#/$defs/Probe"
            },
            "root": {
              "$ref": "#/$defs/DataRoot"
            },
            "shared_data": {
              "$ref": "#/$defs/SharedData"
            },
            "state": {
              "$ref": "#/$defs/RelPath"
            },
            "versions": {
              "description": "One folder per release under the root.",
              "$ref": "#/$defs/RelPath"
            }
          },
          "additionalProperties": false,
          "required": [
            "kind",
            "root",
            "versions",
            "current",
            "state",
            "format_detection",
            "executable",
            "shared_data",
            "probe"
          ]
        },
        {
          "description": "A zip that holds an AppImage, unpacked with `--appimage-extract` so no FUSE is needed.",
          "type": "object",
          "properties": {
            "current": {
              "$ref": "#/$defs/RelPath"
            },
            "executable": {
              "$ref": "#/$defs/PerOs"
            },
            "extracted_name": {
              "description": "The AppImage's name in the version folder while it unpacks.",
              "$ref": "#/$defs/RelPath"
            },
            "kind": {
              "type": "string",
              "const": "zip_appimage"
            },
            "member_selection": {
              "$ref": "#/$defs/MemberSelection"
            },
            "probe": {
              "$ref": "#/$defs/Probe"
            },
            "root": {
              "$ref": "#/$defs/DataRoot"
            },
            "shared_data": {
              "$ref": "#/$defs/SharedData"
            },
            "state": {
              "$ref": "#/$defs/RelPath"
            },
            "versions": {
              "$ref": "#/$defs/RelPath"
            },
            "zip_member_suffix": {
              "description": "The zip member to take: the first whose name ends with this.",
              "type": "string"
            }
          },
          "additionalProperties": false,
          "required": [
            "kind",
            "root",
            "versions",
            "current",
            "state",
            "zip_member_suffix",
            "member_selection",
            "extracted_name",
            "executable",
            "shared_data",
            "probe"
          ]
        }
      ]
    },
    "Integrity": {
      "description": "How a download is checked.",
      "oneOf": [
        {
          "description": "The SHA-256 digest GitHub lists for the asset. `required: false`: an asset without a\ndigest still installs; a wrong digest never does.",
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "github_asset_sha256"
            },
            "required": {
              "type": "boolean"
            }
          },
          "additionalProperties": false,
          "required": [
            "kind",
            "required"
          ]
        }
      ]
    },
    "InvalidValue": {
      "oneOf": [
        {
          "description": "The setting's default.",
          "type": "string",
          "const": "default"
        }
      ]
    },
    "Launch": {
      "description": "How a game starts. The launcher runs the executable directly, never through a shell.",
      "type": "object",
      "properties": {
        "arguments": {
          "description": "The arguments, in order.",
          "type": "array",
          "items": {
            "$ref": "#/$defs/LaunchArg"
          }
        },
        "cwd": {
          "$ref": "#/$defs/LaunchCwd"
        },
        "env": {
          "type": "object",
          "additionalProperties": false,
          "patternProperties": {
            "^[A-Za-z_][A-Za-z0-9_]{0,127}$": {
              "type": "string"
            }
          }
        },
        "env_remove": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/EnvName"
          }
        },
        "inherit_environment": {
          "type": "boolean"
        }
      },
      "additionalProperties": false,
      "required": [
        "cwd",
        "inherit_environment",
        "arguments"
      ]
    },
    "LaunchArg": {
      "description": "One part of the command line.",
      "oneOf": [
        {
          "description": "This text, as one argument.",
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "literal"
            },
            "text": {
              "type": "string"
            }
          },
          "additionalProperties": false,
