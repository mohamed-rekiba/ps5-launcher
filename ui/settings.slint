// Settings: the right-side sheet over the dimmed app (docs/screenshots/settings.jpg). One sheet
// scrolls through the Launcher's sections, then SYSTEM, whose areas are entry rows; an entry row
// opens the area's sub-sheet in the same panel. Each row is its own box: a text field has its
// label above it and its hint below; switches and ‹ value › pickers sit in the row. The focused
// row has the white ring.

import { S, Theme, Icons, Zone, SettingData, SettingsHit, PairCard } from "theme.slint";
import { Switch, BackButton } from "widgets.slint";
import { AboutSlint } from "std-widgets.slint";

// The rows of a sheet, or of a setup step.
export component SettingRows inherits VerticalLayout {
    in property <[SettingData]> rows;
    in property <int> selected: -1;
    in property <int> edit-index: -1;
    in-out property <string> edit-text;
    in property <length> hint-w;
    // The space over the first heading.
    in property <length> first-gap: (8px * S.k);
    // The on-screen keyboard edits the row: the field shows its text, without a caret.
    in property <bool> osk;
    // Where the caret goes when the field opens (a byte offset); -1 selects all.
    in property <int> caret: -1;
    callback choose(int);
    callback edit-done(string, bool);
    spacing: 0;
    for s[i] in root.rows: VerticalLayout {
        property <bool> f: root.selected == i;
        padding-top: s.kind == 0 ? (s.label == "" ? (20px * S.k) : i == 0 ? root.first-gap : (36px * S.k)) : (8px * S.k);
        padding-bottom: s.kind == 0 ? (10px * S.k) : (4px * S.k);
        spacing: (6px * S.k);
        // A heading, with a dot when something waits in its section.
        if s.kind == 0 && s.label != "": HorizontalLayout {
            alignment: start;
            spacing: (10px * S.k);
            Text { text: s.label; font-size: (16px * S.k); font-weight: 600; letter-spacing: (2px * S.k); color: Theme.text3; }
            if s.dot: VerticalLayout {
                alignment: center;
                Rectangle { width: (8px * S.k); height: (8px * S.k); border-radius: (4px * S.k); background: Theme.warn; }
            }
        }
        // A text field: its label above, the field itself, its hint below.
        if s.kind == 1: Text { text: s.label; font-size: (19px * S.k); color: Theme.text2; }
        if s.kind == 1: Rectangle {
            height: (54px * S.k);
            border-radius: (12px * S.k);
            background: f ? #ffffff1f : #ffffff12;
            border-width: f ? (3px * S.k) : 1px;
            border-color: f ? #ffffff : (s.hint-kind == 2 ? Theme.danger : Theme.line);
            if root.edit-index != i || root.osk: Text {
                x: (18px * S.k);
                width: parent.width - (36px * S.k);
                text: s.value != "" ? s.value : (s.secret ? "Not set" : "—");
                font-size: (19px * S.k);
                color: s.value != "" ? Theme.text : Theme.text3;
                vertical-alignment: center;
                overflow: elide;
                font-family: "DejaVu Sans Mono";
            }
            if root.edit-index == i && !root.osk: TextInput {
                x: (18px * S.k);
                width: parent.width - (36px * S.k);
                height: parent.height;
                text <=> root.edit-text;
                single-line: true;
                input-type: s.secret ? InputType.password : InputType.text;
                font-size: (19px * S.k);
                color: Theme.text;
                vertical-alignment: center;
                font-family: "DejaVu Sans Mono";
                init => {
                    self.focus();
                    if root.caret < 0 { self.select-all(); } else { self.set-selection-offsets(root.caret, root.caret); }
                }
                accepted => { root.edit-done(self.text, true); }
            }
            TouchArea { mouse-cursor: pointer; clicked => { root.choose(i); } }
        }
        // A switch, a picker or a button: its own row box.
        if s.kind >= 2: Rectangle {
            height: (64px * S.k);
            border-radius: (12px * S.k);
            background: f ? (s.danger ? #ff5a6a40 : #ffffff1f) : #ffffff0d;
            border-width: f ? (3px * S.k) : 1px;
            border-color: f ? (s.danger ? Theme.danger : #ffffff) : Theme.line;
            HorizontalLayout {
                padding-left: (18px * S.k);
                padding-right: (18px * S.k);
                spacing: (12px * S.k);
                Text {
                    text: s.label;
                    font-size: (19px * S.k);
                    color: s.danger ? #ffb3bb : Theme.text;
                    vertical-alignment: center;
                    horizontal-stretch: 1;
                    overflow: elide;
                    font-weight: s.kind == 4 ? 600 : 400;
                }
                if s.dot: VerticalLayout {
                    alignment: center;
                    Rectangle { width: (10px * S.k); height: (10px * S.k); border-radius: (5px * S.k); background: Theme.warn; }
                }
                // A Wi-Fi network: a lock when it is secured, and its signal.
                if s.lock: VerticalLayout {
                    alignment: center;
                    Image { source: Icons.lock; colorize: Theme.text3; width: (18px * S.k); height: (18px * S.k); }
                }
                if s.bars > 0: VerticalLayout {
                    alignment: center;
                    Rectangle {
                        width: (30px * S.k);
                        height: (26px * S.k);
                        for b[j] in [1, 2, 3, 4]: Rectangle {
                            x: (j * 8px * S.k);
                            width: (5px * S.k);
                            height: ((6px + j * 5px) * S.k);
                            y: parent.height - self.height;
                            border-radius: (1.5px * S.k);
                            background: b <= s.bars ? Theme.text : #ffffff26;
                        }
                    }
                }
                if s.kind == 2: VerticalLayout { alignment: center; Switch { on: s.on; } }
                if s.kind == 3: HorizontalLayout {
                    spacing: (8px * S.k);
                    VerticalLayout { alignment: center; Image { source: Icons.chevl; colorize: f ? Theme.text : Theme.text3; width: (22px * S.k); height: (22px * S.k); } }
                    Text { text: s.value; font-size: (19px * S.k); color: Theme.text; vertical-alignment: center; }
                    VerticalLayout { alignment: center; Image { source: Icons.chevr; colorize: f ? Theme.text : Theme.text3; width: (22px * S.k); height: (22px * S.k); } }
                }
                if s.kind == 4 && s.value != "": Text {
                    text: s.value;
                    font-size: (16px * S.k);
                    font-weight: s.value-kind == 3 ? 600 : 400;
                    color: s.value-kind == 1 ? Theme.ok : s.value-kind == 2 ? Theme.danger : s.value-kind == 3 ? #7ab4ff : Theme.text3;
                    vertical-alignment: center;
                }
                // An entry row opens its area.
                if s.more: VerticalLayout {
                    alignment: center;
                    Image { source: Icons.chevr; colorize: f ? Theme.text : Theme.text2; width: (24px * S.k); height: (24px * S.k); }
                }
            }
            TouchArea { mouse-cursor: pointer; clicked => { root.choose(i); } }
        }
        if s.kind != 0 && s.hint != "": Text {
            text: s.hint;
            width: root.hint-w;
            font-size: (16px * S.k);
            wrap: word-wrap;
            color: s.hint-kind == 1 ? Theme.ok : s.hint-kind == 2 ? Theme.danger : Theme.text3;
        }
    }
}

// A stepper's steps: bars side by side with their labels under them, or, when narrow, one step a
// line with its bar before it. warn: the step on screen failed.
component Stepper inherits VerticalLayout {
    in property <[string]> steps;
    in property <int> at;
    in property <bool> warn;
    in property <bool> narrow;
    if !root.narrow: HorizontalLayout {
        spacing: (8px * S.k);
        for s[i] in root.steps: VerticalLayout {
            spacing: (8px * S.k);
            horizontal-stretch: 1;
            Rectangle {
                height: (6px * S.k);
                border-radius: (3px * S.k);
                background: i < root.at ? Theme.ok : i == root.at ? (root.warn ? Theme.danger : Theme.accent) : #ffffff1f;
            }
            Text {
                text: s;
                font-size: (16px * S.k);
                font-weight: i == root.at ? 600 : 400;
                color: i == root.at ? Theme.text : Theme.text3;
            }
        }
    }
    if root.narrow: VerticalLayout {
        spacing: (10px * S.k);
        for s[i] in root.steps: HorizontalLayout {
            spacing: (14px * S.k);
            alignment: start;
            VerticalLayout {
                alignment: center;
                Rectangle {
                    width: (34px * S.k);
                    height: (6px * S.k);
                    border-radius: (3px * S.k);
                    background: i < root.at ? Theme.ok : i == root.at ? (root.warn ? Theme.danger : Theme.accent) : #ffffff1f;
                }
            }
            Text {
                text: s;
                font-size: (17px * S.k);
                font-weight: i == root.at ? 600 : 400;
                color: i == root.at ? Theme.text : i < root.at ? Theme.text2 : Theme.text3;
            }
        }
    }
}

// A button to hold while pairing: blue, with a ring. Others are dim.
component PadButton inherits Rectangle {
    in property <bool> hold;
    in property <string> label;
    background: hold ? Theme.accent : #ffffff1a;
    border-width: hold ? (3px * S.k) : 1px;
    border-color: hold ? #8fb6ff : #ffffff33;
    if root.label != "": Text {
        text: root.label;
        font-size: (11px * S.k);
        font-weight: 600;
        color: root.hold ? #ffffff : Theme.text3;
    }
}

// A controller drawn from plain shapes, with the buttons to hold for pairing. kind: 0 DualSense
// and DualShock 4, 1 Xbox, 2 Switch Pro.
component PadDrawing inherits Rectangle {
    in property <int> kind;
    height: (150px * S.k);
    // The body and its two grips.
    body := Rectangle {
        x: (parent.width - self.width) / 2;
        y: (24px * S.k);
        width: (220px * S.k);
        height: (96px * S.k);
        border-radius: (40px * S.k);
        background: #ffffff10;
        border-width: (2px * S.k);
        border-color: #ffffff38;
    }
    for g[i] in [0, 1]: Rectangle {
        x: body.x + (i == 0 ? (6px * S.k) : body.width - self.width - (6px * S.k));
        y: body.y + (40px * S.k);
        width: (64px * S.k);
        height: (80px * S.k);
        border-radius: (32px * S.k);
        background: #ffffff10;
        border-width: (2px * S.k);
        border-color: #ffffff38;
    }
    // The d-pad and the face buttons, dim.
    Rectangle { x: body.x + (44px * S.k); y: body.y + (26px * S.k); width: (24px * S.k); height: (8px * S.k); background: #ffffff26; }
    Rectangle { x: body.x + (52px * S.k); y: body.y + (18px * S.k); width: (8px * S.k); height: (24px * S.k); background: #ffffff26; }
    for b[i] in [{x: 160, y: 14}, {x: 148, y: 26}, {x: 172, y: 26}, {x: 160, y: 38}]: Rectangle {
        x: body.x + (b.x * 1px * S.k);
        y: body.y + (b.y * 1px * S.k);
        width: (11px * S.k);
        height: (11px * S.k);
        border-radius: (5.5px * S.k);
        background: #ffffff26;
    }
    // DualSense and DualShock 4: Create (Share) left of the touchpad, PS below it.
    if root.kind == 0: Rectangle {
        x: body.x + (80px * S.k);
        y: body.y + (8px * S.k);
        width: (60px * S.k);
        height: (34px * S.k);
        border-radius: (6px * S.k);
        background: #ffffff0d;
        border-width: 1px;
        border-color: #ffffff33;
    }
    if root.kind == 0: PadButton { hold: true; x: body.x + (66px * S.k); y: body.y + (6px * S.k); width: (12px * S.k); height: (22px * S.k); border-radius: (5px * S.k); }
    if root.kind == 0: PadButton { hold: true; label: "PS"; x: body.x + (96px * S.k); y: body.y + (54px * S.k); width: (28px * S.k); height: (28px * S.k); border-radius: (14px * S.k); }
    if root.kind == 0: Text { x: body.x - (6px * S.k); y: (0px * S.k); text: "Create / Share"; font-size: (13px * S.k); color: #8fb6ff; }
    // Xbox: the Xbox button lights up; the pair button is on the top edge, by the cable port.
    if root.kind == 1: PadButton { hold: false; label: "X"; x: body.x + (96px * S.k); y: body.y + (8px * S.k); width: (28px * S.k); height: (28px * S.k); border-radius: (14px * S.k); }
    if root.kind == 1: Rectangle { x: body.x + (100px * S.k); y: body.y - (6px * S.k); width: (20px * S.k); height: (8px * S.k); border-radius: (2px * S.k); background: #ffffff33; }
    if root.kind == 1: PadButton { hold: true; x: body.x + (132px * S.k); y: body.y - (10px * S.k); width: (20px * S.k); height: (12px * S.k); border-radius: (4px * S.k); }
    if root.kind == 1: Text { x: body.x + (112px * S.k); y: (0px * S.k); text: "Pair"; font-size: (13px * S.k); color: #8fb6ff; }
    // Switch Pro: the small sync button on the top edge, left of the cable port.
    if root.kind == 2: Rectangle { x: body.x + (100px * S.k); y: body.y - (6px * S.k); width: (20px * S.k); height: (8px * S.k); border-radius: (2px * S.k); background: #ffffff33; }
    if root.kind == 2: PadButton { hold: true; x: body.x + (78px * S.k); y: body.y - (10px * S.k); width: (14px * S.k); height: (14px * S.k); border-radius: (7px * S.k); }
    if root.kind == 2: PadButton { hold: false; label: "⌂"; x: body.x + (120px * S.k); y: body.y + (40px * S.k); width: (20px * S.k); height: (20px * S.k); border-radius: (10px * S.k); }
    if root.kind == 2: Text { x: body.x + (48px * S.k); y: (0px * S.k); text: "Sync"; font-size: (13px * S.k); color: #8fb6ff; }
}

// Pairing a controller on Controllers: the steps, then a card with the state, the buttons to hold
// for each controller type, or the error. Its buttons are the rows under it.
export component PairSteps inherits VerticalLayout {
    in property <PairCard> card;
    in property <length> text-w;
    // In the Settings sheet: the steps one a line, and the controllers one under the other.
    in property <bool> narrow;
    property <[{kind: int, title: string, text: string}]> pads: [
        {kind: 0, title: "DualSense · DualShock 4", text: "Hold PS and Create (Share on a DualShock 4) until the light bar flashes."},
        {kind: 1, title: "Xbox", text: "Turn it on, then hold the pair button on top until the Xbox button flashes fast."},
        {kind: 2, title: "Switch Pro", text: "Hold the small sync button on top, next to the cable port, until the lights run."},
    ];
    padding-bottom: (28px * S.k);
    spacing: (22px * S.k);
    Stepper {
        steps: ["1  Pairing mode", "2  Scan", "3  Pair", "4  Connect"];
        at: root.card.step;
        warn: root.card.kind == 1;
        narrow: root.narrow;
    }
    Rectangle {
        border-radius: (14px * S.k);
        background: #121a31;
        border-width: 1px;
        border-color: root.card.kind == 1 ? Theme.danger : Theme.line;
        VerticalLayout {
            padding: (28px * S.k);
            spacing: (12px * S.k);
            HorizontalLayout {
                spacing: (14px * S.k);
                alignment: start;
                VerticalLayout {
                    alignment: center;
                    Image {
                        source: root.card.kind == 1 ? Icons.alert : root.card.kind == 2 ? Icons.check : Icons.pad;
                        colorize: root.card.kind == 1 ? Theme.danger : root.card.kind == 2 ? Theme.ok : Theme.text;
                        width: (34px * S.k);
                        height: (34px * S.k);
                    }
                }
                Text { text: root.card.title; width: root.text-w - (48px * S.k); wrap: word-wrap; font-size: (28px * S.k); font-weight: 600; color: Theme.text; vertical-alignment: center; }
            }
            for line[i] in root.card.lines: Text {
                text: line;
                width: root.text-w;
                wrap: word-wrap;
                font-size: i == 0 ? (20px * S.k) : (16px * S.k);
                color: i == 0 ? (root.card.kind == 1 ? #ffb3bb : Theme.text) : Theme.text3;
            }
            // Three controllers side by side, each over its text.
            if root.card.pictures && !root.narrow: HorizontalLayout {
                padding-top: (12px * S.k);
                spacing: (24px * S.k);
                for p in root.pads: VerticalLayout {
                    spacing: (10px * S.k);
                    PadDrawing { kind: p.kind; }
                    Text { text: p.title; font-size: (18px * S.k); font-weight: 600; color: Theme.text; horizontal-alignment: center; }
                    Text { text: p.text; width: (root.text-w - (48px * S.k)) / 3; font-size: (15px * S.k); color: Theme.text2; wrap: word-wrap; horizontal-alignment: center; }
                }
            }
            // Narrow: one controller a line, its text beside it.
            if root.card.pictures && root.narrow: VerticalLayout {
                padding-top: (4px * S.k);
                spacing: (8px * S.k);
                for p in root.pads: HorizontalLayout {
                    spacing: (16px * S.k);
                    PadDrawing { kind: p.kind; width: (236px * S.k); }
                    VerticalLayout {
                        alignment: center;
                        spacing: (6px * S.k);
                        Text { text: p.title; font-size: (18px * S.k); font-weight: 600; color: Theme.text; }
                        Text { text: p.text; width: root.text-w - (252px * S.k); font-size: (15px * S.k); color: Theme.text2; wrap: word-wrap; }
                    }
                }
            }
        }
    }
}

// The sheet: a panel on the right over the dimmed app. A click outside it closes Settings.
export component SettingsSheet inherits Rectangle {
    // The open sub-sheet's title; empty: the root sheet.
    in property <string> title;
    // The app's focus: Zone.settings (the rows), settings-find or settings-hits.
    in property <int> zone;
    in property <int> idx;
    in property <[SettingData]> rows;
    in property <int> edit-index: -1;
    in-out property <string> edit-text;
    in-out property <length> scroll-y;
    in-out property <string> query;
    // The search field has the keyboard.
    in property <bool> find-editing;
    in property <[SettingsHit]> hits;
    // The About card under the rows: About's sub-sheet, or the root sheet on a desktop.
    in property <bool> about;
    // Controllers: pairing a controller, over the rows.
    in property <PairCard> pair;
    in property <string> version;
    in property <string> mode;
    // Why changes are not saved (config.json cannot be written); empty when they are.
    in property <string> warning;
    in property <bool> pad;
    // The on-screen keyboard is open: it edits the search field or a row instead of them.
    in property <bool> osk;
    // Where the caret goes when the search field or a row takes the keyboard (a byte offset);
    // -1: the end of the search, all of a row selected.
    in property <int> caret: -1;
    callback click(int, int);
    callback edit-done(string, bool);
    callback find-edited(string);
    callback find-done();
    callback back();

    property <bool> sub: root.title != "";
    property <length> inner: (648px * S.k);
    property <bool> entered: false;
    init => { entered = true; }
    background: entered ? #03050ccc : #03050c00;
    animate background { duration: 260ms; }
    TouchArea { clicked => { root.click(Zone.settings, -1); } }
    Rectangle {
        x: root.width - (760px * S.k) + (root.entered ? 0 : (120px * S.k));
        opacity: root.entered ? 1 : 0;
        animate x { duration: 420ms; easing: ease-out-expo; }
        animate opacity { duration: 220ms; easing: ease-out-quad; }
        width: (760px * S.k);
        background: @linear-gradient(180deg, #111a33 0%, #0a1024 100%);
        border-width: 1px;
        border-color: Theme.line;
        TouchArea {}
        Flickable {
            content-y <=> root.scroll-y;
            content-height: sheet.preferred-height;
            sheet := VerticalLayout {
                x: 0;
                y: 0;
                width: (760px * S.k);
                height: self.preferred-height;
                padding-left: (56px * S.k);
                padding-right: (56px * S.k);
                padding-top: (64px * S.k);
                padding-bottom: (120px * S.k);
                spacing: 0;
                HorizontalLayout {
                    alignment: start;
                    padding-bottom: (20px * S.k);
                    BackButton { pad: root.pad; clicked => { root.back(); } }
                }
                Text { text: root.sub ? root.title : "Settings"; font-size: (44px * S.k); font-weight: 600; color: Theme.text; }
                if root.warning == "": Text { text: root.sub ? "System" : "Changes are saved automatically"; font-size: (18px * S.k); color: Theme.text3; }
                if root.warning != "": Text { text: root.warning; font-size: (18px * S.k); color: Theme.danger; wrap: word-wrap; width: root.inner; }

                // The search field, and its hits under it while it or a hit has focus.
                if !root.sub: VerticalLayout {
                    padding-top: (24px * S.k);
                    spacing: (8px * S.k);
                    Rectangle {
                        property <bool> f: root.zone == Zone.settings-find;
                        height: (54px * S.k);
                        border-radius: (12px * S.k);
                        background: f ? #ffffff1f : #ffffff12;
                        border-width: f ? (3px * S.k) : 1px;
                        border-color: f ? #ffffff : Theme.line;
                        Image {
                            x: (18px * S.k);
                            source: Icons.search;
                            colorize: Theme.text2;
                            width: (24px * S.k);
                            height: (24px * S.k);
                        }
                        if root.find-editing && !root.osk: TextInput {
                            x: (56px * S.k);
                            width: parent.width - (74px * S.k);
                            height: parent.height;
                            text <=> root.query;
                            single-line: true;
                            font-size: (19px * S.k);
                            color: Theme.text;
                            vertical-alignment: center;
                            init => {
                                self.focus();
                                self.set-selection-offsets(root.caret < 0 ? 1000000 : root.caret, root.caret < 0 ? 1000000 : root.caret);
                            }
                            edited => { root.find-edited(self.text); }
                            accepted => { root.find-done(); }
                        }
                        if !root.find-editing || root.osk: Text {
                            x: (56px * S.k);
                            width: parent.width - (74px * S.k);
                            text: root.query != "" ? root.query : "Search settings";
                            font-size: (19px * S.k);
                            color: root.query != "" ? Theme.text : Theme.text3;
                            vertical-alignment: center;
                            overflow: elide;
                        }
                        TouchArea { mouse-cursor: text; clicked => { root.click(Zone.settings-find, 0); } }
                    }
                    if root.query != "" && (root.zone == Zone.settings-find || root.zone == Zone.settings-hits): VerticalLayout {
                        padding-top: (4px * S.k);
                        spacing: (8px * S.k);
                        for h[i] in root.hits: Rectangle {
                            property <bool> f: root.zone == Zone.settings-hits && root.idx == i;
                            height: (64px * S.k);
                            border-radius: (12px * S.k);
                            background: f ? #ffffff1f : #ffffff0d;
                            border-width: f ? (3px * S.k) : 1px;
                            border-color: f ? #ffffff : Theme.line;
                            HorizontalLayout {
                                padding-left: (18px * S.k);
                                padding-right: (18px * S.k);
                                spacing: (12px * S.k);
                                Text { text: h.label; font-size: (19px * S.k); color: Theme.text; vertical-alignment: center; overflow: elide; horizontal-stretch: 1; }
                                Text { text: h.place; font-size: (16px * S.k); color: Theme.text3; vertical-alignment: center; }
                            }
                            TouchArea { mouse-cursor: pointer; clicked => { root.click(Zone.settings-hits, i); } }
                        }
                        if root.hits.length == 0: Text {
                            height: (64px * S.k);
                            text: "No settings match";
                            font-size: (19px * S.k);
                            color: Theme.text3;
                            vertical-alignment: center;
                        }
                    }
                }
                if root.sub: Rectangle { height: (20px * S.k); }

                // A System area's cards over its rows.
                if root.pair.show: PairSteps { card: root.pair; text-w: root.inner - (56px * S.k); narrow: true; }
                SettingRows {
                    rows: root.rows;
                    selected: root.zone == Zone.settings ? root.idx : -1;
                    edit-index: root.edit-index;
                    edit-text <=> root.edit-text;
                    hint-w: root.inner;
                    first-gap: (36px * S.k);
                    osk: root.osk;
                    caret: root.caret;
                    choose(i) => { root.click(Zone.settings, i); }
                    edit-done(text, accepted) => { root.edit-done(text, accepted); }
                }
                // About: the required attribution for the Slint royalty-free license (section 2a).
                if root.about: VerticalLayout {
                    padding-top: (36px * S.k);
                    spacing: (12px * S.k);
                    Text { text: "ABOUT"; font-size: (16px * S.k); font-weight: 600; letter-spacing: (2px * S.k); color: Theme.text3; }
                    Rectangle {
                        border-radius: (12px * S.k);
                        background: #ffffff0d;
                        border-width: 1px;
                        border-color: Theme.line;
                        HorizontalLayout {
                            padding-left: (18px * S.k);
                            padding-right: (10px * S.k);
                            padding-top: (14px * S.k);
                            padding-bottom: (14px * S.k);
                            spacing: (16px * S.k);
                            VerticalLayout {
                                alignment: center;
                                Image { source: Icons.app; width: (56px * S.k); height: (56px * S.k); }
                            }
                            VerticalLayout {
                                alignment: center;
                                spacing: (4px * S.k);
                                horizontal-stretch: 1;
                                Text { text: "PS5 Launcher"; font-size: (19px * S.k); font-weight: 600; color: Theme.text; }
                                Text { text: "Version " + root.version + " · " + root.mode; font-size: (15px * S.k); color: Theme.text3; }
                                Text { text: "PS5 games on KytyPS5 · PS4 games on shadPS4"; font-size: (15px * S.k); color: Theme.text3; wrap: word-wrap; }
                            }
                            VerticalLayout {
                                alignment: center;
                                AboutSlint { width: (170px * S.k); }
                            }
                        }
                    }
                }
            }
        }
    }
}
