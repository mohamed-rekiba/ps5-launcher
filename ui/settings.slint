// Settings, full screen: a side rail on the left with the categories in two groups, Launcher and
// System, and the open category's page on the right (docs/plans/ps5-launcher-os.md, Phase 4; the
// prototype's pick A). The rail shows labels while it has focus and folds to icons when focus
// moves into the page. One focus style, the app's own: the focused rail entry or search hit turns
// white; the focused row gets the white ring it has always had.

import { S, Theme, Icons, Zone, SettingData, SettingsCat, SettingsHit, NvCard } from "theme.slint";
import { Switch, KeyCap } from "widgets.slint";
import { AboutSlint } from "std-widgets.slint";

// The rows of one page. Rows between two headers share a card.
component SettingRows inherits VerticalLayout {
    in property <[SettingData]> rows;
    in property <int> selected: -1;
    in property <int> edit-index: -1;
    in-out property <string> edit-text;
    in property <length> hint-w;
    // The on-screen keyboard edits the row: the field below stays closed.
    in property <bool> osk;
    // Where the caret goes when the field opens (a byte offset); -1 selects all.
    in property <int> caret: -1;
    callback choose(int);
    callback edit-done(string, bool);
    spacing: 0;
    for s[i] in root.rows: VerticalLayout {
        property <bool> f: root.selected == i;
        property <length> r: (14px * S.k);
        padding-top: s.kind == 0 ? (i == 0 ? (8px * S.k) : (32px * S.k)) : 0;
        padding-bottom: s.kind == 0 ? (12px * S.k) : 0;
        if s.kind == 0: Text { text: s.label; font-size: (16px * S.k); font-weight: 600; letter-spacing: (2px * S.k); color: Theme.text3; }
        if s.kind != 0: Rectangle {
            background: f ? (s.danger ? #ff5a6a33 : #ffffff1f) : (s.danger ? #ff5a6a0d : #ffffff0b);
            border-top-left-radius: s.group-first || f ? r : 0;
            border-top-right-radius: s.group-first || f ? r : 0;
            border-bottom-left-radius: s.group-last || f ? r : 0;
            border-bottom-right-radius: s.group-last || f ? r : 0;
            border-width: f ? (3px * S.k) : 0;
            border-color: s.danger ? Theme.danger : #ffffff;
            if !s.group-first && !f && root.selected != i - 1: Rectangle {
                x: (18px * S.k);
                y: 0;
                width: parent.width - (36px * S.k);
                height: 1px;
                background: Theme.line;
            }
            TouchArea { mouse-cursor: pointer; clicked => { root.choose(i); } }
            VerticalLayout {
                padding-left: (18px * S.k);
                padding-right: (18px * S.k);
                padding-top: (14px * S.k);
                padding-bottom: (14px * S.k);
                spacing: (4px * S.k);
                HorizontalLayout {
                    spacing: (16px * S.k);
                    min-height: (36px * S.k);
                    Text {
                        text: s.label;
                        font-size: (19px * S.k);
                        font-weight: s.kind == 4 ? 600 : 500;
                        color: s.danger ? #ffb3bb : Theme.text;
                        vertical-alignment: center;
                        horizontal-stretch: s.kind == 1 ? 0 : 1;
                    }
                    if s.kind == 1 && (root.edit-index != i || root.osk): Text {
                        text: s.value != "" ? s.value : (s.secret ? "Not set" : "—");
                        font-size: (17px * S.k);
                        font-family: "DejaVu Sans Mono";
                        color: s.value != "" ? Theme.text2 : Theme.text3;
                        horizontal-alignment: right;
                        vertical-alignment: center;
                        horizontal-stretch: 1;
                        min-width: (120px * S.k);
                        overflow: elide;
                    }
                    if s.kind == 2: VerticalLayout { alignment: center; Switch { on: s.on; } }
                    if s.kind == 3: HorizontalLayout {
                        spacing: (8px * S.k);
                        alignment: end;
                        Image { source: Icons.chevl; colorize: f ? Theme.text : Theme.text3; width: (22px * S.k); height: (22px * S.k); y: (7px * S.k); }
                        Text { text: s.value; font-size: (19px * S.k); color: Theme.text; vertical-alignment: center; }
                        Image { source: Icons.chevr; colorize: f ? Theme.text : Theme.text3; width: (22px * S.k); height: (22px * S.k); y: (7px * S.k); }
                    }
                    // A Wi-Fi network: a lock when it is secured, and its signal.
                    if s.lock: Image {
                        source: Icons.lock;
                        colorize: Theme.text3;
                        width: (18px * S.k);
                        height: (18px * S.k);
                        y: (9px * S.k);
                    }
                    if s.bars > 0: Rectangle {
                        width: (30px * S.k);
                        for b[j] in [1, 2, 3, 4]: Rectangle {
                            x: (j * 8px * S.k);
                            width: (5px * S.k);
                            height: ((6px + j * 5px) * S.k);
                            y: (27px * S.k) - self.height;
                            border-radius: (1.5px * S.k);
                            background: b <= s.bars ? Theme.text : #ffffff26;
                        }
                    }
                    if s.kind == 4 && s.value != "": Text {
                        text: s.value;
                        font-size: (17px * S.k);
                        font-weight: s.value-kind == 3 ? 600 : 400;
                        color: s.value-kind == 1 ? Theme.ok : s.value-kind == 2 ? Theme.danger : s.value-kind == 3 ? #7ab4ff : Theme.text3;
                        vertical-alignment: center;
                    }
                }
                if s.kind == 1 && root.edit-index == i && !root.osk: Rectangle {
                    height: (50px * S.k);
                    border-radius: (10px * S.k);
                    background: #00000040;
                    border-width: 1px;
                    border-color: Theme.line;
                    TextInput {
                        x: (14px * S.k);
                        width: parent.width - (28px * S.k);
                        height: parent.height;
                        text <=> root.edit-text;
                        single-line: true;
                        input-type: s.secret ? InputType.password : InputType.text;
                        font-size: (18px * S.k);
                        color: Theme.text;
                        vertical-alignment: center;
                        font-family: "DejaVu Sans Mono";
                        init => {
                            self.focus();
                            if root.caret < 0 { self.select-all(); } else { self.set-selection-offsets(root.caret, root.caret); }
                        }
                        accepted => { root.edit-done(self.text, true); }
                    }
                }
                if s.hint != "": Text {
                    text: s.hint;
                    width: root.hint-w;
                    font-size: (15px * S.k);
                    wrap: word-wrap;
                    color: s.hint-kind == 1 ? Theme.ok : s.hint-kind == 2 ? Theme.danger : Theme.text3;
                }
            }
        }
    }
}

// The NVIDIA image's Secure Boot key waits for the blue MOK screen at the next start: its password
// in large digits, numbered, because the screen may ask for single digits; then the steps.
component KeySteps inherits VerticalLayout {
    in property <[string]> digits;
    in property <length> text-w;
    // The last step: what to do back in the launcher.
    in property <string> last;
    padding-bottom: (28px * S.k);
    Rectangle {
        border-radius: (14px * S.k);
        background: #ffffff0b;
        border-width: 1px;
        border-color: Theme.warn;
        VerticalLayout {
            padding: (28px * S.k);
            spacing: (14px * S.k);
            Text { text: "Enroll the NVIDIA driver's key"; font-size: (24px * S.k); font-weight: 600; color: Theme.text; }
            Text {
                text: "Secure Boot loads the new NVIDIA driver only after its key is enrolled. You do this once, on a blue screen when the PC starts. That screen needs a USB keyboard: a controller does not work there.";
                width: root.text-w;
                wrap: word-wrap;
                font-size: (17px * S.k);
                color: Theme.text2;
            }
            HorizontalLayout {
                alignment: start;
                spacing: (12px * S.k);
                padding-top: (6px * S.k);
                padding-bottom: (6px * S.k);
                for d[i] in root.digits: VerticalLayout {
                    spacing: (6px * S.k);
                    Rectangle {
                        width: (72px * S.k);
                        height: (92px * S.k);
                        border-radius: (12px * S.k);
                        background: #ffffff16;
                        Text { text: d; font-size: (58px * S.k); font-weight: 600; font-family: "DejaVu Sans Mono"; color: Theme.text; }
                    }
                    Text { text: i + 1; font-size: (15px * S.k); color: Theme.text3; horizontal-alignment: center; }
                }
            }
            for step[i] in [
                "Plug in a USB keyboard, then restart the PC from the Power menu.",
                "A blue screen says \"Perform MOK management\". Press any key within 10 seconds. If you miss it, restart again.",
                "Choose \"Enroll MOK\", then \"Continue\", then \"Yes\".",
                "Type the password above and press Enter. If the screen asks for single digits, the numbers under the digits tell you which one.",
                root.last,
            ]: HorizontalLayout {
                spacing: (12px * S.k);
                Text { text: (i + 1) + "."; width: (24px * S.k); font-size: (17px * S.k); font-weight: 600; color: Theme.text; }
                Text { text: step; width: root.text-w - (36px * S.k); wrap: word-wrap; font-size: (17px * S.k); color: Theme.text; }
            }
        }
    }
}

// The NVIDIA driver on the Display page (the prototype's stepper): the numbered steps, then a
// card with a title and its text. Its buttons are the rows under it.
component NvidiaCard inherits VerticalLayout {
    in property <NvCard> card;
    in property <length> text-w;
    padding-bottom: (28px * S.k);
    spacing: (22px * S.k);
    if root.card.step >= 0: HorizontalLayout {
        spacing: (8px * S.k);
        for s[i] in ["1  Install", "2  Secure Boot key", "3  Download", "4  Restart"]: VerticalLayout {
            spacing: (8px * S.k);
            horizontal-stretch: 1;
            Rectangle {
                height: (6px * S.k);
                border-radius: (3px * S.k);
                background: i < root.card.step ? Theme.ok : i == root.card.step ? Theme.accent : #ffffff1f;
            }
            Text {
                text: s;
                font-size: (16px * S.k);
                font-weight: i == root.card.step ? 600 : 400;
                color: i == root.card.step ? Theme.text : Theme.text3;
            }
        }
    }
    Rectangle {
        border-radius: (14px * S.k);
        background: #121a31;
        border-width: 1px;
        border-color: root.card.kind == 1 ? Theme.warn : Theme.line;
        VerticalLayout {
            padding: (28px * S.k);
            spacing: (12px * S.k);
            HorizontalLayout {
                spacing: (14px * S.k);
                alignment: start;
                Image {
                    source: root.card.kind == 0 ? Icons.chip : root.card.kind == 2 ? Icons.check : Icons.info;
                    colorize: root.card.kind == 0 ? #76b900 : root.card.kind == 1 ? Theme.warn : root.card.kind == 2 ? Theme.ok : Theme.text2;
                    width: (34px * S.k);
                    height: (34px * S.k);
                    y: (3px * S.k);
                }
                Text { text: root.card.title; font-size: (28px * S.k); font-weight: 600; color: Theme.text; vertical-alignment: center; }
            }
            for line[i] in root.card.lines: Text {
                text: line;
                width: root.text-w;
                wrap: word-wrap;
                font-size: i == 0 ? (20px * S.k) : (16px * S.k);
                font-weight: i == 0 && root.card.kind == 1 ? 600 : 400;
                color: i == 0 ? (root.card.kind == 1 ? Theme.warn : Theme.text) : Theme.text3;
            }
        }
    }
}

export component SettingsPage inherits Rectangle {
    in property <[SettingsCat]> cats;
    in property <int> cat;
    // The app's focus: Zone.settings-rail, settings-find, settings-hits, or settings (the page).
    in property <int> zone;
    in property <int> idx;
    in property <[SettingData]> rows;
    in property <int> edit-index: -1;
    in-out property <string> edit-text;
    in-out property <length> scroll-y;
    in-out property <string> query;
    // The search field has the keyboard.
    in property <bool> find-editing;
    in property <[SettingsHit]> hits;
    // The About card under the rows (System and About pages): version, mode, Slint.
    in property <bool> about;
    // The Updates page (OS): the Secure Boot key's password, a digit each, over its steps.
    in property <[string]> key;
    in property <string> key-last;
    // The Display page: the NVIDIA driver's card over the rows.
    in property <NvCard> nv;
    in property <string> version;
    in property <string> mode;
    in property <bool> pad;
    // The on-screen keyboard is open: it edits the search field or a row instead of them.
    in property <bool> osk;
    // Where the caret goes when the search field or a row takes the keyboard (a byte offset);
    // -1: the end of the search, all of a row selected.
    in property <int> caret: -1;
    callback click(int, int);
    callback edit-done(string, bool);
    callback find-edited(string);
    callback find-done();
    callback back();

    property <bool> folded: root.zone == Zone.settings;
    property <bool> finding: root.zone == Zone.settings-find || root.zone == Zone.settings-hits;
    property <length> rail-w: folded ? (116px * S.k) : (400px * S.k);
    property <SettingsCat> current: root.cats[root.cat];
    property <bool> entered: false;
    init => { entered = true; }
    opacity: entered ? 1 : 0;
    animate opacity { duration: 200ms; easing: ease-out-quad; }
    background: @radial-gradient(circle, #101a3a 0%, Theme.bg 75%);
    TouchArea {}

    // ---------------------------------------------------------------- the page
    page := Rectangle {
        x: root.rail-w + (72px * S.k);
        width: min((1100px * S.k), root.width - self.x - (96px * S.k));
        animate x { duration: 300ms; easing: ease-out-expo; }
        Text {
            x: 0;
            y: (52px * S.k);
            text: root.current.system ? "SYSTEM" : "LAUNCHER";
            font-size: (16px * S.k);
            font-weight: 600;
            letter-spacing: (2px * S.k);
            color: Theme.text3;
        }
        Text { x: 0; y: (74px * S.k); text: root.current.label; font-size: (44px * S.k); font-weight: 600; color: Theme.text; }
        if !root.current.system: Text {
            x: parent.width - self.width;
            y: (96px * S.k);
            text: "Changes are saved automatically";
            font-size: (16px * S.k);
            color: Theme.text3;
        }
        Rectangle {
            y: (170px * S.k);
            height: root.height - self.y - (110px * S.k);
            clip: true;
            Flickable {
                content-y <=> root.scroll-y;
                content-height: list.preferred-height;
                list := VerticalLayout {
                    x: 0;
                    y: 0;
                    width: page.width;
                    height: self.preferred-height;
                    padding-bottom: (24px * S.k);
                    if root.nv.show: NvidiaCard { card: root.nv; text-w: page.width - (56px * S.k); }
                    if root.key.length > 0: KeySteps { digits: root.key; text-w: page.width - (56px * S.k); last: root.key-last; }
                    SettingRows {
                        rows: root.rows;
                        selected: root.zone == Zone.settings ? root.idx : -1;
                        edit-index: root.edit-index;
                        edit-text <=> root.edit-text;
                        hint-w: page.width - (36px * S.k);
                        osk: root.osk;
                        caret: root.caret;
                        choose(i) => { root.click(Zone.settings, i); }
                        edit-done(text, accepted) => { root.edit-done(text, accepted); }
                    }
                    // About: the required attribution for the Slint royalty-free license (section 2a).
                    if root.about: VerticalLayout {
                        padding-top: root.rows.length > 0 ? (36px * S.k) : (8px * S.k);
                        Rectangle {
                            border-radius: (14px * S.k);
                            background: #ffffff0b;
                            HorizontalLayout {
                                padding-left: (18px * S.k);
                                padding-right: (10px * S.k);
                                padding-top: (14px * S.k);
                                padding-bottom: (14px * S.k);
                                spacing: (16px * S.k);
                                VerticalLayout {
                                    alignment: center;
                                    Image { source: Icons.app; width: (60px * S.k); height: (60px * S.k); }
                                }
                                VerticalLayout {
                                    alignment: center;
                                    spacing: (4px * S.k);
                                    horizontal-stretch: 1;
                                    Text { text: "PS5 Launcher"; font-size: (19px * S.k); font-weight: 600; color: Theme.text; }
                                    Text { text: "Version " + root.version + " · " + root.mode; font-size: (15px * S.k); color: Theme.text3; }
                                    Text { text: "PS5 games on KytyPS5 · PS4 games on shadPS4"; font-size: (15px * S.k); color: Theme.text3; }
                                }
                                VerticalLayout {
                                    alignment: center;
                                    AboutSlint { width: (190px * S.k); }
                                }
                            }
                        }
                    }
                }
            }
        }
    }

    // ---------------------------------------------------------------- the rail
    rail := Rectangle {
        x: 0;
        width: root.rail-w;
        background: #0a1024;
        border-width: 1px;
        border-color: Theme.line;
        clip: true;
        animate width { duration: 300ms; easing: ease-out-expo; }
        property <bool> labels: self.width > (300px * S.k);
        VerticalLayout {
            padding-top: (44px * S.k);
            padding-left: (28px * S.k);
            padding-right: (28px * S.k);
            spacing: 0;
            alignment: start;
            Text { text: rail.labels ? "Settings" : ""; font-size: (40px * S.k); font-weight: 600; color: Theme.text; height: (60px * S.k); }
            // The search field.
            Rectangle {
                property <bool> f: root.zone == Zone.settings-find;
                height: (54px * S.k);
                border-radius: (27px * S.k);
                background: f ? #ffffff24 : #ffffff10;
                border-width: f ? (3px * S.k) : 1px;
                border-color: f ? #ffffff : Theme.line;
                Image {
                    x: (16px * S.k);
                    source: Icons.search;
                    colorize: Theme.text2;
                    width: (24px * S.k);
                    height: (24px * S.k);
                }
                if root.find-editing && !root.osk: TextInput {
                    x: (52px * S.k);
                    width: parent.width - (68px * S.k);
                    height: parent.height;
                    text <=> root.query;
                    single-line: true;
                    font-size: (18px * S.k);
                    color: Theme.text;
                    vertical-alignment: center;
                    init => {
                        self.focus();
                        self.set-selection-offsets(root.caret < 0 ? 1000000 : root.caret, root.caret < 0 ? 1000000 : root.caret);
                    }
                    edited => { root.find-edited(self.text); }
                    accepted => { root.find-done(); }
                }
                if (!root.find-editing || root.osk) && rail.labels: Text {
                    x: (52px * S.k);
                    width: parent.width - (68px * S.k);
                    text: root.query != "" ? root.query : "Search settings";
                    font-size: (18px * S.k);
                    color: root.query != "" ? Theme.text : Theme.text3;
                    vertical-alignment: center;
                    overflow: elide;
                }
                TouchArea { mouse-cursor: text; clicked => { root.click(Zone.settings-find, 0); } }
            }
            Rectangle { height: (22px * S.k); }
            for c[i] in root.cats: VerticalLayout {
                if i == 0: Text {
                    text: rail.labels ? "LAUNCHER" : "";
                    height: (34px * S.k);
                    vertical-alignment: bottom;
                    font-size: (14px * S.k);
                    font-weight: 600;
                    letter-spacing: (2px * S.k);
                    color: Theme.text3;
                }
                // The divider above the System group.
                if c.sep: VerticalLayout {
                    padding-top: (18px * S.k);
                    Rectangle { height: 1px; background: Theme.line; }
                    Text {
                        text: rail.labels ? "SYSTEM" : "";
                        height: (34px * S.k);
                        vertical-alignment: bottom;
                        font-size: (14px * S.k);
                        font-weight: 600;
                        letter-spacing: (2px * S.k);
                        color: Theme.text3;
                    }
                }
                Rectangle { height: (6px * S.k); }
                Rectangle {
                    property <bool> sel: root.cat == i;
                    property <bool> foc: sel && root.zone == Zone.settings-rail;
                    height: (54px * S.k);
                    border-radius: (14px * S.k);
                    background: foc ? #ffffff : sel ? #ffffff1c : ta.has-hover ? #ffffff0e : transparent;
                    animate background { duration: Theme.fast; }
                    Image {
                        x: (16px * S.k);
                        source: Icons.get(c.icon);
                        colorize: foc ? #0a0d18 : sel ? Theme.text : Theme.text2;
                        width: (28px * S.k);
                        height: (28px * S.k);
                    }
                    Text {
                        x: (60px * S.k);
                        text: c.label;
                        font-size: (20px * S.k);
                        font-weight: sel ? 600 : 500;
                        color: foc ? #0a0d18 : sel ? Theme.text : Theme.text2;
                        vertical-alignment: center;
                        height: parent.height;
                        opacity: rail.labels ? 1 : 0;
                        animate opacity { duration: 150ms; }
                    }
                    if c.dot: Rectangle {
                        x: rail.labels ? parent.width - (30px * S.k) : (38px * S.k);
                        y: rail.labels ? (parent.height - self.height) / 2 : (8px * S.k);
                        width: (12px * S.k);
                        height: (12px * S.k);
                        border-radius: (6px * S.k);
                        background: Theme.warn;
                    }
                    ta := TouchArea { mouse-cursor: pointer; clicked => { root.click(Zone.settings-rail, i); } }
                }
            }
        }
    }

    // ---------------------------------------------------------------- search hits, over the rail
    if root.finding && root.query != "": Rectangle {
        x: (28px * S.k);
        y: (164px * S.k);
        width: (560px * S.k);
        height: hl.preferred-height;
        border-radius: (16px * S.k);
        background: #18223f;
        border-width: 1px;
        border-color: Theme.line;
        drop-shadow-blur: (40px * S.k);
        drop-shadow-color: #000000aa;
        TouchArea {}
        hl := VerticalLayout {
            padding: (8px * S.k);
            for h[i] in root.hits: Rectangle {
                property <bool> f: root.zone == Zone.settings-hits && root.idx == i;
                height: (56px * S.k);
                border-radius: (12px * S.k);
                background: f ? #ffffff : hta.has-hover ? #ffffff14 : transparent;
                HorizontalLayout {
                    padding-left: (16px * S.k);
                    padding-right: (16px * S.k);
                    spacing: (12px * S.k);
                    Text {
                        text: h.label;
                        font-size: (19px * S.k);
                        font-weight: 500;
                        color: f ? #0a0d18 : Theme.text;
                        vertical-alignment: center;
                        overflow: elide;
                        horizontal-stretch: 1;
                    }
                    Text {
                        text: h.place;
                        font-size: (16px * S.k);
                        color: f ? #33405e : Theme.text3;
                        vertical-alignment: center;
                        horizontal-alignment: right;
                    }
                }
                hta := TouchArea { mouse-cursor: pointer; clicked => { root.click(Zone.settings-hits, i); } }
            }
            if root.hits.length == 0: Text {
                height: (56px * S.k);
                x: (16px * S.k);
                text: "No settings match";
                font-size: (19px * S.k);
                color: Theme.text3;
                vertical-alignment: center;
            }
        }
    }

    // ---------------------------------------------------------------- button hints
    HorizontalLayout {
        x: root.width - self.preferred-width - (48px * S.k);
        y: root.height - self.height - (36px * S.k);
        height: (50px * S.k);
        spacing: (24px * S.k);
        for h[i] in root.pad
            ? [{k: "✕", l: "Select", c: #8fb6ff, r: true}, {k: "○", l: "Back", c: #ff8f9c, r: true}, {k: "L1 R1", l: "Category", c: #ffffff, r: false}, {k: "△", l: "Search", c: #5fe0c0, r: true}]
            : [{k: "Enter", l: "Select", c: #ffffff, r: false}, {k: "Esc", l: "Back", c: #ffffff, r: false}, {k: "Tab", l: "Category", c: #ffffff, r: false}, {k: "/", l: "Search", c: #ffffff, r: false}]
            : Rectangle {
                width: hint.preferred-width;
                hint := HorizontalLayout {
                    spacing: (10px * S.k);
                    KeyCap { text: h.k; round: h.r; fg: h.c; y: (10px * S.k); }
                    Text { text: h.l; font-size: (17px * S.k); color: Theme.text2; vertical-alignment: center; }
                }
                TouchArea {
                    mouse-cursor: pointer;
                    clicked => {
                        if i == 1 { root.back(); }
                        if i == 3 { root.click(Zone.settings-find, 0); }
                    }
                }
            }
    }
}
