// The first-start setup of PS5 Launcher OS (docs/plans/ps5-launcher-os.md, Phase 7), full screen
// like the PS5's own: the steps on top, the step's title and text, then the System page's own rows
// and cards (the same components as Settings), and the buttons at the bottom, the main one last.

import { S, Theme, Zone, SettingData, NvCard, PairCard, SetupView } from "theme.slint";
import { KeyCap } from "widgets.slint";
import { SettingRows, KeySteps, NvidiaCard, PairSteps } from "settings.slint";
import { PowerButton } from "power.slint";

export component SetupPage inherits Rectangle {
    in property <SetupView> view;
    // The app's focus: Zone.settings (the rows) or Zone.setup-nav (the buttons).
    in property <int> zone;
    in property <int> idx;
    in property <[SettingData]> rows;
    in property <int> edit-index: -1;
    in-out property <string> edit-text;
    in-out property <length> scroll-y;
    in property <[string]> key;
    in property <string> key-last;
    in property <NvCard> nv;
    in property <PairCard> pair;
    in property <bool> pad;
    in property <bool> osk;
    in property <int> caret: -1;
    callback click(int, int);
    callback edit-done(string, bool);

    property <bool> entered: false;
    init => { entered = true; }
    opacity: entered ? 1 : 0;
    animate opacity { duration: 250ms; easing: ease-out-quad; }
    background: @radial-gradient(circle, #101a3a 0%, Theme.bg 75%);
    TouchArea {}

    col := Rectangle {
        width: min((1100px * S.k), root.width - (192px * S.k));
        x: (root.width - self.width) / 2;

        Text {
            y: (52px * S.k);
            text: root.view.kicker;
            font-size: (16px * S.k);
            font-weight: 600;
            letter-spacing: (2px * S.k);
            color: Theme.text3;
        }
        // The steps: done ones green, the one on screen blue.
        HorizontalLayout {
            y: (88px * S.k);
            height: (40px * S.k);
            spacing: (8px * S.k);
            for s[i] in root.view.steps: VerticalLayout {
                spacing: (8px * S.k);
                horizontal-stretch: 1;
                Rectangle {
                    height: (6px * S.k);
                    border-radius: (3px * S.k);
                    background: i < root.view.at ? Theme.ok : i == root.view.at ? Theme.accent : #ffffff1f;
                    animate background { duration: Theme.fast; }
                }
                Text {
                    text: s;
                    font-size: (16px * S.k);
                    font-weight: i == root.view.at ? 600 : 400;
                    color: i == root.view.at ? Theme.text : i < root.view.at ? Theme.text2 : Theme.text3;
                }
            }
        }
        Text {
            y: (160px * S.k);
            width: parent.width;
            text: root.view.title;
            font-size: (44px * S.k);
            font-weight: 600;
            color: Theme.text;
            wrap: word-wrap;
        }
        Text {
            y: (230px * S.k);
            width: parent.width;
            text: root.view.text;
            font-size: (20px * S.k);
            color: Theme.text2;
            wrap: word-wrap;
        }

        // The page: the step's cards and rows.
        Rectangle {
            y: (330px * S.k);
            height: root.height - self.y - (150px * S.k);
            clip: true;
            Flickable {
                content-y <=> root.scroll-y;
                content-height: list.preferred-height;
                list := VerticalLayout {
                    x: 0;
                    y: 0;
                    width: col.width;
                    height: self.preferred-height;
                    padding-bottom: (24px * S.k);
                    if root.nv.show: NvidiaCard { card: root.nv; text-w: col.width - (56px * S.k); }
                    if root.pair.show: PairSteps { card: root.pair; text-w: col.width - (56px * S.k); }
                    if root.key.length > 0: KeySteps { digits: root.key; text-w: col.width - (56px * S.k); last: root.key-last; }
                    SettingRows {
                        rows: root.rows;
                        selected: root.zone == Zone.settings ? root.idx : -1;
                        edit-index: root.edit-index;
                        edit-text <=> root.edit-text;
                        hint-w: col.width - (36px * S.k);
                        osk: root.osk;
                        caret: root.caret;
                        choose(i) => { root.click(Zone.settings, i); }
                        edit-done(text, accepted) => { root.edit-done(text, accepted); }
                    }
                }
            }
        }

        // The buttons, right; the button hints, left.
        HorizontalLayout {
            x: parent.width - self.preferred-width;
            y: root.height - (118px * S.k);
            spacing: (16px * S.k);
            for b[i] in root.view.buttons: PowerButton {
                text: b;
                focused: root.zone == Zone.setup-nav && root.idx == i;
                clicked => { root.click(Zone.setup-nav, i); }
            }
        }
        HorizontalLayout {
            x: 0;
            y: root.height - (102px * S.k);
            height: (30px * S.k);
            spacing: (24px * S.k);
            for h in root.pad
                ? [{k: "✕", l: "Select", c: #8fb6ff, r: true}, {k: "○", l: "Back", c: #ff8f9c, r: true}]
                : [{k: "Enter", l: "Select", c: #ffffff, r: false}, {k: "Esc", l: "Back", c: #ffffff, r: false}]
                : HorizontalLayout {
                    spacing: (10px * S.k);
                    KeyCap { text: h.k; round: h.r; fg: h.c; }
                    Text { text: h.l; font-size: (17px * S.k); color: Theme.text2; vertical-alignment: center; }
                }
        }
    }
}
