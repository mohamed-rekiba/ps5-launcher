# PS5 Launcher OS: the firewall, the boot health check and the signature enforcement on, and no
# SSH server by default. The image has an empty /etc/machine-id, so systemd applies the presets
# at the first start, and Fedora's 90-default.preset would enable sshd again. This file sorts
# first, so it wins. An owner or a kickstart can still enable sshd.
disable sshd.service
disable sshd.socket
enable firewalld.service
enable ps5-boot-health.service
enable ps5-signature-policy.service
