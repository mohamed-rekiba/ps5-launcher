#!/usr/bin/bash
# PS5 Launcher OS's recovery menu (ps5-recovery-menu.service, on tty1, as root). It runs when the
# PC starts with systemd.unit=ps5-recovery.target (an edit in the GRUB menu; see
# packaging/os/README.md). It needs no login and no launcher, and it does only what the
# launcher's root helper does, through the helper, so the helper's checks stay:
#   1  switch to the main image          helper switch main
#   3  roll back to the previous system  helper rollback (no network needed)
#   4  restart
# Errors are shown, and the menu comes back. The paths are fixed; test-recovery-menu.sh tests a
# copy with them changed.
set -u
helper=/usr/libexec/ps5-launcher/helper
os_release=/usr/lib/ps5-launcher/os-release
notice=/var/lib/ps5-launcher-os/health/notice.json
PATH=/usr/sbin:/usr/bin
export PATH
out_file=$(mktemp)

say() { printf '%s\n' "$@"; }
ask() { # PROMPT: reads one line into $answer; the end of input ends the menu
    printf '%s' "$1"
    IFS= read -r answer || { echo; exit 0; }
}

header() {
    local image digest net
    image=$(sed -n 's/^IMAGE=//p' "$os_release" 2>/dev/null | head -1)
    digest=$("$helper" status 2>/dev/null | sed -n '/{/,$p' | jq -r '.status.booted.image.imageDigest // "unknown"' 2>/dev/null)
    net=$(timeout 5 nmcli -t -f STATE general 2>/dev/null || echo unknown)
    say "" "===== PS5 Launcher OS recovery =====" \
        "This system: ${image:-unknown} image, ${digest:-unknown}" \
        "Network: $net (switching images needs it; a cable is the easiest; rolling back does not)"
    if [ -r "$notice" ]; then
        say "Last boot check: $(jq -r '"\(.outcome): \(.reason)"' "$notice" 2>/dev/null)"
    fi
    say "" \
        "  1  Switch to the main image (AMD, Intel, and NVIDIA on the open-source driver)" \
        "  2  Roll back to the previous system" \
        "  3  Restart" ""
}

# Runs the helper with its output on screen. Sets $code.
run_helper() {
    say "Running: helper $*"
    [ "$1" != switch ] || say "(the download can take several minutes)"
    "$helper" "$@" 2>&1 | tee "$out_file"
    code=${PIPESTATUS[0]}
}

done_restart() {
    say "" "Done. $1 at the next restart."
    ask "Restart now? [y/N] "
    case $answer in y | Y | yes) restart ;; esac
}

restart() {
    say "Restarting..."
    systemctl reboot
    exit 0
}

while :; do
    header
    ask "Choose 1-3: "
    case $answer in
    1)
        run_helper switch main
        if [ "$code" = 0 ]; then done_restart "The main image starts"; else say "" "The switch failed (exit $code). Nothing was switched."; fi
        ;;
    2)
        run_helper rollback
        if [ "$code" = 0 ]; then done_restart "The previous system starts"; else say "" "The rollback failed (exit $code)."; fi
        ;;
    3) restart ;;
    *) say "Type 1, 2 or 3, then Enter." ;;
    esac
done
