#!/bin/sh
# PS5 Launcher OS's root helper: the few system tasks the launcher may do, and nothing else.
# The launcher runs it through pkexec; polkit allows it for the user at the PC without a
# password (/usr/share/polkit-1/actions/io.github.ps5launcher.helper.policy). Its paths are
# fixed, so nothing in the caller's environment can redirect it; test-helper.sh tests a copy
# with these lines changed.
#
#   helper set-next-session plasma   log in to Plasma once, at the next automatic login
#   helper clear-next-session        forget that (Plasma's autostart, and every boot)
#   helper status                    bootc status --json (it needs root on a booted system)
#   helper update-check              is a system update available? (A channel whose image is not signed with our key fails.)
#   helper update                    download a system update; it installs at the next restart
#   helper rollback                  start the previous system at the next restart
#   helper switch main        follow the main image (next restart)
#   helper set-timezone <zone>       set the time zone to one that timedatectl lists
#   helper set-ntp on|off            set the time automatically, or not
#   helper health-ack                delete the boot health check's notice (the launcher showed it)
#
# Image signatures (packaging/os/signing/README.md): every image this helper trusts is checked
# first, by its exact digest, against the system's containers policy and the shipped key, with
# $verify (skopeo's image proxy; only the manifest, the signatures and the config are fetched).
# Every bootc switch passes
# --enforce-container-sigpolicy, so bootc stores the choice and its later pulls require it too.
# An image that fails the check stops the task (exit 1) before bootc runs.
#
# update, switch and rollback hold $lock_file while they run, and so does the boot health check
# (/usr/libexec/ps5-launcher-os/boot-health) before it rolls back: the two never change the
# deployments at the same time. A task that cannot get the lock within $short seconds fails.
#
set -eu
sddm_dir=/etc/sddm.conf.d
os_release=/usr/lib/ps5-launcher/os-release
health_dir=/var/lib/ps5-launcher-os/health
lock_file=/run/ps5-launcher-os.lock
verify=/usr/libexec/ps5-launcher/verify-image
# How long a task may run, in seconds. timeout runs as root here, so it can stop the work; the
# launcher's own deadline cannot stop a process pkexec started as root.
short=30
check=120
long=7200
PATH=/usr/sbin:/usr/bin
export PATH
next_session="$sddm_dir/90-ps5-launcher-os-next-session.conf"

usage() {
    echo "usage: helper set-next-session plasma | clear-next-session | status | update-check | update | rollback | switch main | set-timezone <zone> | set-ntp on|off | health-ack" >&2
    exit 2
}

fail() {
    echo "helper: $*" >&2
    exit 1
}

# Waits for the lock that update, switch, rollback and the boot health check share. It stays
# held until the helper (or the bootc it execs) ends.
lock() {
    exec 9>>"$lock_file"
    flock -w "$short" 9 || fail "another system task is running; try again later"
}

# A value from the OS marker ("IMAGE", "IMAGE_REF").
marker() {
    sed -n "s/^$1=//p" "$os_release" | head -1
}

# The digest `ref` (NAME:TAG) points at now, checked against the signature policy. Sets $digest,
# skopeo inspect only finds the digest; $verify checks exactly that digest.
verified_digest() {
    digest=$(timeout -k 10 "$check" skopeo inspect --format "{{.Digest}}" "docker://$1") ||
        fail "could not read $1"
    printf '%s' "$digest" | grep -qxE 'sha256:[0-9a-f]{64}' || fail "no digest for $1"
    timeout -k 10 "$check" "$verify" "${1%:*}@$digest" >/dev/null ||
        fail "${1%:*}@$digest: no valid signature by this system's image signing key"
}

# Whether $1 is a time zone timedatectl lists. First the name itself: one to three parts of
# letters, digits, "_", "+" and "-", split by "/", none starting with "-". No dot, so no "..",
# and no line break.
valid_zone() {
    case "$1" in
    "" | *[!A-Za-z0-9_+/-]* | /* | */ | *//* | -* | */-* | */*/*/*) return 1 ;;
    esac
    timeout -k 10 "$short" timedatectl list-timezones | grep -qxF -- "$1"
}

# Whether bootc stores the signature enforcement for the image it follows (bootc status shows
# "signature": "containerPolicy" in its spec; a fresh install has none until
# ps5-signature-policy.service ran).
enforced() {
    [ "$(timeout -k 10 "$short" bootc status --json --format-version=1 | sed -n '/{/,$p' |
        jq -r '.spec.image.signature // empty')" = containerPolicy ]
}

[ $# -ge 1 ] || usage
task=$1
shift
case "$task $#" in
"set-next-session 1")
    [ "$1" = plasma ] || usage
    # Only a real folder that no one else can write to, and never through a symlink: the file
    # is written aside, the old name is deleted (rm removes a symlink itself, not its target),
    # then the file is renamed into place.
    if [ -L "$sddm_dir" ] || [ ! -d "$sddm_dir" ] ||
        [ -z "$(find "$sddm_dir" -maxdepth 0 -user "$(id -u)" ! -perm -g+w ! -perm -o+w)" ]; then
        fail "$sddm_dir is not a folder only this user can write to"
    fi
    tmp=$(mktemp "$sddm_dir/.next-session.XXXXXX")
    printf '# Written by "Switch to desktop"; deleted when Plasma starts.\n[Autologin]\nSession=plasma.desktop\n' \
        > "$tmp"
    chmod 644 "$tmp"
    rm -f "$next_session"
    mv -f "$tmp" "$next_session"
    ;;
"clear-next-session 0") rm -f "$next_session" ;;
"status 0") exec timeout -k 10 "$short" bootc status --json ;;
"update-check 0")
    verified_digest "$(marker IMAGE_REF)"
    exec timeout -k 10 "$check" bootc upgrade --check
    ;;
"update 0")
    lock
    # bootc upgrade follows the stored choice. Without it (a rollback to the installed system),
    # the same channel is switched to with the enforcement, which also stages its newest image.
    if enforced; then
        exec timeout -k 10 "$long" bootc upgrade
    fi
    ref=$(marker IMAGE_REF)
    [ -n "$ref" ] || fail "$os_release has no IMAGE_REF"
    verified_digest "$ref"
    exec timeout -k 10 "$long" bootc switch --enforce-container-sigpolicy "$ref"
    ;;
"rollback 0")
    lock
    exec timeout -k 10 "$check" bootc rollback
    ;;
"switch 1")
    case "$1" in main) ;; *) usage ;; esac
    lock
    ref=$(marker IMAGE_REF)
    [ -n "$ref" ] || fail "$os_release has no IMAGE_REF"
    case "$1" in
    main)
        verified_digest "${ref%:*}:main"
        exec timeout -k 10 "$long" bootc switch --enforce-container-sigpolicy "${ref%:*}:main"
        ;;
    *) usage ;;
    esac
    ;;
"set-timezone 1")
    valid_zone "$1" || fail "not a time zone: $1"
    exec timeout -k 10 "$short" timedatectl set-timezone "$1"
    ;;
"set-ntp 1")
    case "$1" in
    on) exec timeout -k 10 "$short" timedatectl set-ntp true ;;
    off) exec timeout -k 10 "$short" timedatectl set-ntp false ;;
    *) usage ;;
    esac
    ;;
"health-ack 0") rm -f "$health_dir/notice.json" ;;
*) usage ;;
esac
