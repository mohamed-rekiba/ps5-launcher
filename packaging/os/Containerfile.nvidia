# PS5 Launcher OS, NVIDIA image: the main image plus one layer with NVIDIA's driver.
#
# Built FROM the exact main image that was tested (MAIN_IMAGE is NAME@sha256:... in CI), so the
# two images share every layer and switching to this one downloads only the driver layer.
# Build with packaging/os/build-image.sh nvidia. The Secure Boot signing key comes in as the
# build secret "sbkey", only for the signing step, and is never written to a layer.
#   IMAGE_REF     the channel this image follows (ghcr.io/OWNER/ps5-launcher-fedora:nvidia)
#   CERT_SHA256   SHA-256 of secureboot/public_key.der; it must be the main image's certificate
ARG MAIN_IMAGE=localhost/ps5-launcher-fedora:main

# Stage 1: build the kernel modules for the main image's kernel, and sign them. This stage is
# thrown away; only the kmod rpm leaves it.
FROM ${MAIN_IMAGE} AS kmods
ARG CERT_SHA256
COPY secureboot/public_key.der /etc/pki/akmods/certs/public_key.der
# akmods builds as its own "akmods" user, so the key must be readable by it (mode 0444). The
# mount exists only while this step runs.
RUN --mount=type=secret,id=sbkey,target=/etc/pki/akmods/private/private_key.priv,mode=0444 \
    set -eux; \
    cert=/etc/pki/akmods/certs/public_key.der; \
    key=/etc/pki/akmods/private/private_key.priv; \
    [ "$(sha256sum "$cert" | cut -d' ' -f1)" = "$CERT_SHA256" ]; \
    # The main image must ship this certificate: the launcher queues it from there.
    [ -f "/usr/share/ps5-launcher/secureboot/$CERT_SHA256.der" ]; \
    # The key must belong to the certificate, or the modules would never load.
    [ "$(openssl x509 -inform DER -in "$cert" -noout -pubkey | openssl pkey -pubin -outform DER | sha256sum)" \
        = "$(openssl pkey -in "$key" -pubout -outform DER | sha256sum)" ]; \
    # The image's kernel, not the build machine's (uname -r would give that).
    kver=$(ls /usr/lib/modules); \
    [ "$(echo "$kver" | wc -l)" = 1 ]; \
    dnf -y install --setopt=install_weak_deps=False --exclude='kernel kernel-core kernel-modules*' \
        "kernel-devel-$kver" akmod-nvidia; \
    # akmods exits 0 even when the build fails, so check for the package it should have made.
    akmods --force --kernels "$kver" --kmod nvidia; \
    if ! ls /var/cache/akmods/nvidia/kmod-nvidia-"$kver"-*.rpm >/dev/null 2>&1; then \
        tail -80 /var/cache/akmods/nvidia/*.failed.log; \
        exit 1; \
    fi; \
    mkdir -p /out; \
    cp /var/cache/akmods/nvidia/kmod-nvidia-"$kver"-*.rpm /out/

# Stage 2: the image.
FROM ${MAIN_IMAGE}
ARG MAIN_IMAGE
ARG IMAGE_REF
ARG CERT_SHA256
# LINT=0 only for emulated builds; see Containerfile.
ARG LINT=1
COPY --from=kmods /out/ /tmp/kmods/
COPY secureboot/public_key.der /tmp/secureboot.der
COPY nvidia/ /
RUN set -eux; \
    case $IMAGE_REF in ?*/?*:?*) ;; *) echo "IMAGE_REF must be NAME:TAG, got '$IMAGE_REF'" >&2; exit 1 ;; esac; \
    kver=$(ls /usr/lib/modules); \
    # The kernel stays the main image's kernel: the modules were built for exactly that one.
    dnf -y install --setopt=install_weak_deps=False --exclude='kernel kernel-core kernel-modules*' \
        /tmp/kmods/*.rpm xorg-x11-drv-nvidia xorg-x11-drv-nvidia-libs nvidia-modprobe; \
    [ "$(ls /usr/lib/modules)" = "$kver" ]; \
    depmod -a "$kver"; \
    # Every NVIDIA module matches this kernel and is signed by our certificate: its signer is the
    # certificate's name, and its key ID is the certificate's serial number.
    cn=$(openssl x509 -inform DER -in /tmp/secureboot.der -noout -subject -nameopt multiline \
        | sed -n 's/^ *commonName *= *//p'); \
    serial=$(openssl x509 -inform DER -in /tmp/secureboot.der -noout -serial | cut -d= -f2 | sed 's/^0*//'); \
    found=0; \
    # Only the modules from our kmod rpm: the kernel has an nvidia-wmi-ec-backlight of its own.
    for ko in $(rpm -qlp /tmp/kmods/*.rpm | grep -E '\.ko(\.xz|\.zst|\.gz)?$'); do \
        [ "$(modinfo -F vermagic "$ko" | cut -d' ' -f1)" = "$kver" ]; \
        [ "$(modinfo -F signer "$ko")" = "$cn" ]; \
        [ "$(modinfo -F sig_key "$ko" | tr -d ':' | tr '[:lower:]' '[:upper:]' | sed 's/^0*//')" = "$serial" ]; \
        echo "$ko: $(modinfo -F license "$ko"), signed by $(modinfo -F signer "$ko")"; \
        found=$((found + 1)); \
    done; \
    [ "$found" -ge 1 ]; \
    # The certificate is the main image's, so the label below stays true for both images.
    [ "$(sha256sum /tmp/secureboot.der | cut -d' ' -f1)" = "$CERT_SHA256" ]; \
    [ -f "/usr/share/ps5-launcher/secureboot/$CERT_SHA256.der" ]; \
    rpm -q --qf '%{VERSION}\n' xorg-x11-drv-nvidia > /usr/lib/ps5-launcher/nvidia-driver-version; \
    printf 'IMAGE=nvidia\nIMAGE_REF=%s\n' "$IMAGE_REF" > /usr/lib/ps5-launcher/os-release; \
    dnf clean all; \
    rm -rf /tmp/* /var/cache/* /var/log/*; \
    if [ "$LINT" = 1 ]; then bootc container lint; fi

LABEL org.opencontainers.image.title="PS5 Launcher OS (NVIDIA)" \
      io.github.ps5-launcher.main-image="${MAIN_IMAGE}" \
      io.github.ps5-launcher.secureboot-cert-sha256="${CERT_SHA256}"
