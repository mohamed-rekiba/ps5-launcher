# PS5 Launcher OS, main image (AMD and Intel graphics, and NVIDIA on the open-source driver):
# Fedora bootc that starts straight into PS5 Launcher.
#
# Build with packaging/os/build-image.sh main. The build context is the folder that script
# stages (target/os/context), not the repository. Every input is pinned by the caller:
#   BASE_IMAGE    fedora-bootc by digest (quay.io/fedora/fedora-bootc@sha256:...)
#   IMAGE_REF     the channel this image follows (ghcr.io/OWNER/ps5-launcher-fedora:main)
# The image signing key's public half comes in as signing/cosign.pub; the containers policy
# (signing/*.in) requires it for IMAGE_REF's repository.
#   LAUNCHER_VERSION  the version of the launcher rpm in launcher/
# build-image.sh supplies the selected release or pinned digest.
ARG BASE_IMAGE
FROM ${BASE_IMAGE}
ARG BASE_IMAGE
ARG IMAGE_REF
ARG LAUNCHER_VERSION
# LINT=0 only when the build runs emulated (an Apple Silicon Mac): bootc container lint needs a
# system call the emulator lacks. CI builds natively and always lints.
ARG LINT=1

# RPM Fusion supplies video decoders (H.264, H.265) for trailers. Its release packages are
# checked against RPM Fusion's keys from
# Fedora's distribution-gpg-keys package before they are installed. Weak dependencies stay off,
# so every package the image needs is listed here.
RUN set -eux; \
    fedora=$(rpm -E %fedora); \
    dnf -y install --setopt=install_weak_deps=False distribution-gpg-keys; \
    keys=/usr/share/distribution-gpg-keys/rpmfusion; \
    rpm --import "$keys/RPM-GPG-KEY-rpmfusion-free-fedora-$fedora" \
        "$keys/RPM-GPG-KEY-rpmfusion-nonfree-fedora-$fedora"; \
    mkdir /tmp/rpmfusion; \
    for repo in free nonfree; do \
        curl -fsSL --retry 3 -o "/tmp/rpmfusion/rpmfusion-$repo-release.rpm" \
            "https://mirrors.rpmfusion.org/$repo/fedora/rpmfusion-$repo-release-$fedora.noarch.rpm"; \
        rpm -K "/tmp/rpmfusion/rpmfusion-$repo-release.rpm" \
            | grep -q ': digests signatures OK$'; \
    done; \
    dnf -y install /tmp/rpmfusion/*.rpm; \
    rm -rf /tmp/rpmfusion; \
    dnf -y remove distribution-gpg-keys; \
    dnf -y install --setopt=install_weak_deps=False \
        sddm \
        gamescope xorg-x11-server-Xwayland \
        mesa-dri-drivers mesa-vulkan-drivers vulkan-loader \
        amd-gpu-firmware intel-gpu-firmware nvidia-gpu-firmware \
        NetworkManager NetworkManager-wifi bluez \
        pipewire pipewire-alsa pipewire-pulseaudio wireplumber \
        udisks2 polkit firewalld \
        skopeo pciutils jq python3; \
    dnf -y install --setopt=install_weak_deps=False --allowerasing \
        ffmpeg-libs mesa-va-drivers-freeworld intel-media-driver; \
    # The fallback desktop behind "Switch to desktop": Plasma with what it needs to be usable.
    dnf -y install --setopt=install_weak_deps=False \
        plasma-workspace plasma-desktop kwin systemsettings polkit-kde \
        plasma-nm plasma-pa bluedevil kscreen powerdevil xdg-desktop-portal-kde \
        breeze-icon-theme dolphin konsole firefox; \
    dnf clean all

# The launcher, from the rpm that packaging/linux/nfpm.yaml builds. Its mandatory dependencies
# come with it; the four it only recommends are listed, because weak dependencies stay off.
COPY launcher/ /tmp/launcher/
RUN set -eux; \
    dnf -y install --setopt=install_weak_deps=False \
        /tmp/launcher/ps5-launcher-*.rpm alsa-lib gamescope mpv-libs yt-dlp; \
    [ "$(rpm -q --qf '%{VERSION}' ps5-launcher)" = "$LAUNCHER_VERSION" ]; \
    dnf clean all; \
    rm -rf /tmp/launcher

COPY files/ /
COPY signing/ /tmp/signing/

RUN set -eux; \
    case $IMAGE_REF in ?*/?*:?*) ;; *) echo "IMAGE_REF must be NAME:TAG, got '$IMAGE_REF'" >&2; exit 1 ;; esac; \
    # The signature policy: reject by default; this image's own repository only with a signature
    # by the shipped key (packaging/os/signing/README.md). The repository is IMAGE_REF's name.
    # Local transports (containers-storage, oci, dir, archives) stay allowed: bootc install run
    # from this image (image-builder) reads it from containers-storage under this very policy.
    repo=${IMAGE_REF%:*}; \
    printf '%s' "$repo" | grep -qxE '[a-z0-9][a-z0-9.:-]*(/[a-z0-9][a-z0-9._-]*)+'; \
    mkdir -p /usr/share/ps5-launcher/signing; \
    install -m 0644 /tmp/signing/cosign.pub /usr/share/ps5-launcher/signing/cosign.pub; \
    openssl pkey -pubin -in /usr/share/ps5-launcher/signing/cosign.pub -noout; \
    sed "s|@REPOSITORY@|$repo|" /tmp/signing/policy.json.in > /etc/containers/policy.json; \
    sed "s|@REPOSITORY@|$repo|" /tmp/signing/registries.yaml.in > /etc/containers/registries.d/ps5-launcher.yaml; \
    chmod 0644 /etc/containers/policy.json /etc/containers/registries.d/ps5-launcher.yaml; \
    jq -e --arg r "$repo" '.default == [{"type": "reject"}] and (.transports.docker | keys == [$r])' \
        /etc/containers/policy.json; \
    chmod 0755 /usr/libexec/ps5-launcher-os/* /usr/libexec/ps5-launcher/helper \
        /usr/libexec/ps5-launcher/verify-image; \
    systemctl enable sddm.service ps5-launcher-os-autologin.service ps5-boot-health.service \
        ps5-signature-policy.service firewalld.service; \
    systemctl set-default graphical.target; \
    # Updates go only through the launcher's helper, which checks image signatures and
    # never restarts the PC by itself; bootc's own timer would apply and reboot.
    systemctl mask bootc-fetch-apply-updates.timer; \
    # No SSH server on a console. Off, not masked, so an owner or a kickstart can turn it on.
    # The preset files/usr/lib/systemd/system-preset/10-ps5-launcher-os.preset keeps it off at
    # the first start too.
    systemctl disable sshd.service sshd.socket; \
    # Tells the launcher it runs in the OS, which image this is, and the channel it follows.
    # src/system.rs reads the IMAGE line.
    mkdir -p /usr/lib/ps5-launcher; \
    printf 'IMAGE=main\nIMAGE_REF=%s\n' "$IMAGE_REF" > /usr/lib/ps5-launcher/os-release; \
    /usr/bin/ps5-launcher --version; \
    # The helper needs these to check a new image's signing key before it stages the image.
    for tool in skopeo pkexec bootc python3; do command -v "$tool"; done; \
    # ps5-signature-policy.service needs these.
    for tool in nm-online flock jq; do command -v "$tool"; done; \
    # The boot health check (/usr/libexec/ps5-launcher-os/boot-health) needs these.
    for tool in jq python3 flock pgrep; do command -v "$tool"; done; \
    rm -rf /var/cache/* /var/log/* /tmp/*; \
    if [ "$LINT" = 1 ]; then bootc container lint; fi

LABEL org.opencontainers.image.title="PS5 Launcher OS" \
      org.opencontainers.image.description="Fedora bootc that starts straight into PS5 Launcher" \
      org.opencontainers.image.source="https://github.com/MohamedAliRashad/ps5-launcher" \
      org.opencontainers.image.licenses="Apache-2.0" \
      io.github.ps5-launcher.base-image="${BASE_IMAGE}" \
      io.github.ps5-launcher.launcher-version="${LAUNCHER_VERSION}"
